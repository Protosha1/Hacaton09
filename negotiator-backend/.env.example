# =============================================================================
# NegotiatorAI — Backend configuration
# =============================================================================
# Скопируйте этот файл в .env и заполните своими значениями.
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# ВАЖНО: .env НЕ коммитится в git — там ваши секреты.
# =============================================================================


# --- Application ---
APP_NAME=NegotiatorAI
APP_VERSION=0.1.0
PORT=8000


# --- Database ---
# SQLite (файл app.db в корне проекта).
# Для PostgreSQL:
#   postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./app.db


# --- LLM (Qwen via Alibaba Cloud) ---
# API-ключ Qwen. Получить: https://dashscope.console.aliyun.com/
# Ключ начинается с "sk-".
# ОБЯЗАТЕЛЬНО замените на свой ключ.
DASHSCOPE_API_KEY=your-key-here

LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Для Пекинского региона:
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Для локального Qwen через Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1


# --- Authentication (JWT) ---
# ОБЯЗАТЕЛЬНО. Минимум 32 символа.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# --- CORS ---
# Список origin через запятую.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Speech-to-Text (faster-whisper) ---
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_TOKEN=hf_your_token_here


# --- Admin seed ---
# ОБЯЗАТЕЛЬНО заполнить перед первым запуском seed_admin.py.
# Минимум 12 символов.
ADMIN_EMAIL=admin@negotiator-ai.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# --- Admin registration controls ---
# Set to False to disable public admin registration entirely.
ADMIN_REGISTRATION_ENABLED=True

# If set, POST /auth/register/admin requires this code in the body.
# Leave empty for open registration (matches v8 spec, dev only).
ADMIN_REGISTRATION_CODE=