# =============================================================================
# NegotiatorAI — Backend configuration
# =============================================================================
# Скопируйте этот файл в .env и заполните своими значениями.
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# ВАЖНО: .env НЕ коммитится в git — там ваши секреты.
# =============================================================================


# --- Application ---
# Название и версия отображаются в Swagger UI.
APP_NAME=NegotiatorAI
APP_VERSION=0.1.0

# Порт, на котором слушает сервер.
PORT=8000


# --- Database ---
# Строка подключения к БД.
#
# Сейчас SQLite (файл app.db в корне проекта). Работает без установки.
# Для PostgreSQL замените на:
#   postgresql+asyncpg://user:password@host:5432/dbname
#
DATABASE_URL=sqlite+aiosqlite:///./app.db


# --- LLM (Qwen via Alibaba Cloud) ---
# API-ключ Qwen. Получить: https://dashscope.console.aliyun.com/
# Ключ начинается с "sk-".
DASHSCOPE_API_KEY=your-key-here

# Базовый URL OpenAI-совместимого API Qwen.
# Международный (Сингапур) регион:
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
# Для Пекинского региона используйте:
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# Для локального Qwen через Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1


# --- Authentication (JWT) ---
# Секретный ключ для подписи JWT-токенов.
#
# ВАЖНО: смените в продакшене!
# Сгенерировать новый:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
SECRET_KEY=change-me-in-production-please-generate-random-string
#
# Алгоритм подписи JWT. HS256 — стандарт для MVP.
ALGORITHM=HS256
#
# Время жизни токена в минутах.
# 10080 = 7 дней.
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# --- Speech-to-Text (faster-whisper) ---
# Настройки для Windows без прав администратора (иначе падает на симлинках).
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
#
# Если у вас есть HF-токен — можно указать для более быстрой загрузки моделей:
# Получить: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# --- Admin seed (Phase 6) ---
# Email и пароль первого администратора (используется seed_admin.py).
ADMIN_EMAIL=admin@negotiator.local
ADMIN_PASSWORD=ChangeMeStrong123!
ADMIN_NAME=Administrator